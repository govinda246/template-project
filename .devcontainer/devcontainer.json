{
  "name": "Secure Phaser Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "runServices": ["egress-proxy"],
  "workspaceFolder": "/workspaces/github_agent_test",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint@3.0.34",
        "esbenp.prettier-vscode@12.4.0"
      ],
      "settings": {
        "chat.defaultConfiguration": {
          "mode": "interactive",
          "approvals": "manual"
        },
        "chat.permissions.default": "default",
        "chat.tools.global.autoApprove": false,
        "chat.tools.edits.autoApprove": {
          "**/*": false
        },
        "chat.tools.eligibleForAutoApproval": {
          "runInTerminal": true,
          "sendToTerminal": false
        },
        "chat.tools.terminal.enableAutoApprove": true,
        "chat.tools.terminal.autoApprove": {
          "/.*/": true,
          "git status": true,
          "git diff": true,
          "git log": true,
          "npm test": true,
          "npm run lint": true,
          "pytest": true,
          "/^(rm|rmdir|unlink|shred|del|erase)\\b/i": false,
          "/^(curl|wget|ssh|scp|sftp|nc|netcat|telnet)\\b/i": false,
          "/^(chmod|chown|chgrp)\\b/i": false,
          "/^(sudo|su|mount|umount|unshare|nsenter|iptables|nft|pkill|killall)\\b/i": false,
          "/^(docker|podman|nerdctl)\\b/i": false,
          "/^git\\s+(push|reset|clean|checkout|restore|rebase|branch\\s+-[dD])\\b/i": false,
          "/^(aws|az|gcloud)\\b/i": false,
          "/^(Remove-Item|Clear-Content|Set-Acl|takeown|icacls)\\b/i": false
        },
        "chat.tools.urls.autoApprove": {},
        "chat.agent.sandbox.enabled": "on",
        "chat.agent.sandbox.network.allowNetwork": false,
        "chat.agent.sandbox.network.allowLocalNetwork": false,
        "chat.agent.sandbox.fileSystem.allowDevToolAccess": false,
        "chat.agent.sandbox.credentials.authenticategit": false,
        "chat.agent.sandbox.credentials.authenticategh": false,
        "chat.agent.sandbox.allowUnsandboxedCommands": false,
        "chat.agent.sandbox.mcpServers": true,
        "chat.agent.sandbox.lspServers": true,
        "chat.sessionSync.enabled": false,
        "terminal.integrated.defaultProfile.linux": "Secure shell",
        "terminal.integrated.profiles.linux": {
          "Secure shell": {
            "path": "/bin/bash",
            "args": [
              "--noprofile",
              "--norc",
              "/workspaces/github_agent_test/scripts/secure-shell"
            ]
          }
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
