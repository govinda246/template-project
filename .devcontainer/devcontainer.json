{
  // VS Codeから接続する2コンテナ構成。Compose側の隔離・資源制限も同時に読み込む。
  "name": "Secure Phaser Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "runServices": ["egress-proxy"],
  "workspaceFolder": "/workspaces/template-project",
  "remoteUser": "node",
  "shutdownAction": "stopCompose",
  "dockerPath": ".devcontainer/docker-host.cmd",
  "initializeCommand": {
    "windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .devcontainer/initialize-docker.ps1"
  },
  "postCreateCommand": "node scripts/verify-shared-agent.mjs --pre-checkout && git submodule update --init --recursive && git -C .github/shared config core.filemode false && git -C .github/shared config core.autocrlf true && node scripts/verify-shared-agent.mjs && node scripts/sync-shared-agent.mjs --check",
  "forwardPorts": ["egress-proxy:3000"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint@3.0.34",
        "esbenp.prettier-vscode@12.4.0",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        // 通常コード・テスト・公開資料の編集と、頻発するGit状態確認だけを自動許可する。
        // ガードレール、依存関係、URL、状態変更コマンドは手動承認を維持する。
        "chat.defaultConfiguration": {
          "mode": "interactive",
          "approvals": "manual"
        },
        "chat.permissions.default": "default",
        "chat.agentFilesLocations": {
          ".github/agents": true,
          ".github/shared/agents": true
        },
        "chat.agentSkillsLocations": {
          ".github/shared/skills": true
        },
        "chat.tools.global.autoApprove": false,
        "chat.tools.edits.autoApprove": {
          "src/**": true,
          "test/**": true,
          "tests/**": true,
          "public/**": true,
          "docs/**": true
        },
        "chat.tools.eligibleForAutoApproval": {
          "runInTerminal": true,
          "sendToTerminal": false
        },
        "chat.tools.terminal.enableAutoApprove": true,
        "chat.tools.terminal.autoApprove": {
          "git --no-pager status --short": true,
          "git --no-pager diff --no-ext-diff --no-textconv": true,
          "git --no-pager diff --no-ext-diff --no-textconv --check": true,
          "git --no-pager diff --no-ext-diff --no-textconv --stat": true,
          "git --no-pager diff --no-ext-diff --no-textconv --cached": true
        },
        "chat.tools.urls.autoApprove": {},
        "chat.agent.sandbox.enabled": "on",
        // Agentの外部通信は完全一致ドメインへ限定し、LAN・資格情報・ホスト開発ツールは公開しない。
        "chat.agent.sandbox.network.allowNetwork": true,
        "chat.agent.sandbox.network.allowedDomains": [
          "registry.npmjs.org",
          "github.com",
          "api.github.com",
          "objects.githubusercontent.com",
          "codeload.github.com",
          "raw.githubusercontent.com",
          "marketplace.visualstudio.com",
          "main.vscode-cdn.net",
          "github.gallerycdn.vsassets.io",
          "dbaeumer.gallerycdn.vsassets.io",
          "esbenp.gallerycdn.vsassets.io",
          "api.individual.githubcopilot.com",
          "api.githubcopilot.com",
          "copilot-proxy.githubusercontent.com"
        ],
        "chat.agent.sandbox.network.allowLocalNetwork": false,
        "chat.agent.sandbox.fileSystem.allowDevToolAccess": false,
        "chat.agent.sandbox.credentials.authenticategit": false,
        "chat.agent.sandbox.credentials.authenticategh": false,
        "chat.agent.sandbox.allowUnsandboxedCommands": false,
        "chat.agent.sandbox.mcpServers": true,
        "chat.agent.sandbox.lspServers": true,
        "chat.sessionSync.enabled": false,
        // workspace内scriptではなく、イメージ生成時にroot所有で配置した信頼済み入口を使う。
        "terminal.integrated.defaultProfile.linux": "Secure shell",
        "terminal.integrated.profiles.linux": {
          "Secure shell": {
            "path": "/bin/bash",
            "args": [
              "--noprofile",
              "--norc",
              "/opt/secure-template/secure-shell"
            ]
          }
        },
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
