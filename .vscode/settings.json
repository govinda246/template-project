{
  // このworkspace設定はWindowsローカル実行専用。
  // Dev Container側のAgent制御は.devcontainer/devcontainer.jsonが担当する。
  "terminal.integrated.defaultProfile.windows": "Secure local sandbox",
  "terminal.integrated.profiles.windows": {
    "Secure local sandbox": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\local-secure-shell.ps1"
      ]
    }
  }
}
