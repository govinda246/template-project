{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "secure: typecheck",
      "type": "shell",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/secure-run", "npm", "run", "typecheck"],
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "secure: test",
      "type": "shell",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/secure-run", "npm", "test"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "secure: build",
      "type": "shell",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/secure-run", "npm", "run", "build"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "secure: dev server",
      "type": "shell",
      "command": "/bin/bash",
      "args": ["${workspaceFolder}/scripts/secure-run", "npm", "run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
