{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ensure Docker Desktop",
      "type": "process",
      "command": "true",
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$ErrorActionPreference = 'Stop'; & docker info *> $null; if ($LASTEXITCODE -ne 0) { & docker desktop start; if ($LASTEXITCODE -ne 0) { throw 'Failed to start Docker Desktop.' } }; $ready = $false; for ($attempt = 0; $attempt -lt 45; $attempt++) { Start-Sleep -Seconds 2; & docker info *> $null; if ($LASTEXITCODE -eq 0) { $ready = $true; break } }; if (-not $ready) { throw 'Docker Desktop did not become ready within 90 seconds.' }; Write-Output 'Docker Desktop is ready.'"
        ]
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Initialize project",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/init-project.mjs",
        "--name",
        "${input:projectName}",
        "--shared-agent-url",
        "${input:sharedAgentRepository}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Setup shared Agent",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/setup-shared-agent.mjs",
        "--url",
        "${input:sharedAgentRepository}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Sync shared Agent",
      "type": "process",
      "command": "node",
      "args": ["scripts/sync-shared-agent.mjs"],
      "problemMatcher": []
    },
    {
      "label": "secure: typecheck",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["--offline", "npm", "run", "typecheck"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "run",
          "typecheck"
        ]
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "secure: test",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["--offline", "npm", "test"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "test"
        ]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "secure: build",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["--offline", "npm", "run", "build"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "run",
          "build"
        ]
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dev server (Dev Container only)",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "dev"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-Command",
          "Write-Error 'The dev server must run in the Dev Container so egress remains allowlisted.'; exit 1"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "projectName",
      "type": "promptString",
      "description": "New project name (lowercase kebab-case)"
    },
    {
      "id": "sharedAgentRepository",
      "type": "promptString",
      "description": "Shared Agent repository URL (optional; leave empty to skip)",
      "default": ""
    }
  ]
}
