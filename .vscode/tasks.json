{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "secure: typecheck",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "typecheck"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\local-secure-run.ps1",
          "--offline",
          "npm",
          "run",
          "typecheck"
        ]
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "secure: test",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "test"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\local-secure-run.ps1",
          "--offline",
          "npm",
          "test"
        ]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "secure: build",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "build"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\local-secure-run.ps1",
          "--offline",
          "npm",
          "run",
          "build"
        ]
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "secure: dev server",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "dev"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\local-secure-run.ps1",
          "npm",
          "run",
          "dev"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
