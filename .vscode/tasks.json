{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "secure: typecheck",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "typecheck"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "run",
          "typecheck"
        ]
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "secure: test",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "test"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "test"
        ]
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "secure: build",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "build"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${env:LOCALAPPDATA}\\SecureTemplate\\local-secure-run.ps1",
          "--project-path",
          "${workspaceFolder}",
          "--offline",
          "npm",
          "run",
          "build"
        ]
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dev server (Dev Container only)",
      "type": "shell",
      "command": "/opt/secure-template/secure-run",
      "args": ["npm", "run", "dev"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-Command",
          "Write-Error 'The dev server must run in the Dev Container so egress remains allowlisted.'; exit 1"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
