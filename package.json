{
  "name": "secure-phaser-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "init-project": "node scripts/init-project.mjs",
    "setup-shared-agent": "node scripts/setup-shared-agent.mjs",
    "sync-shared-agent": "node scripts/sync-shared-agent.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
