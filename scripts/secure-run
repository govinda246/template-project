#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: secure-run [--offline] COMMAND [ARG...]" >&2
  exit 64
fi

network_args=()
if [[ ${1:-} == "--offline" ]]; then
  # 外部通信が不要なコマンドでは、proxyを使わずnetwork namespaceごと切り離す。
  network_args=(--unshare-net)
  shift
fi

if [[ $# -eq 0 ]]; then
  echo "secure-run: command is required after --offline" >&2
  exit 64
fi

command_name="$(basename -- "$1")"
# コマンド名拒否は誤操作を減らす補助策。主要防御はsocket非公開・権限・mount・network分離。
case "$command_name" in
  bwrap|copilot|copilot-cli|github-copilot-cli|docker|podman|sudo|su|mount|umount|pivot_root|unshare|nsenter|iptables|nft|ip|slirp4netns|ssh|scp)
    echo "secure-run: dangerous command '$command_name' is not permitted" >&2
    exit 126
    ;;
esac

command_line="${*,,}"
if [[ "$command_line" == *copilot* ]]; then
  echo "secure-run: GitHub Copilot CLI is not permitted" >&2
  exit 126
fi

project_root="${SECURE_PROJECT_ROOT:-}"
if [[ -z "$project_root" ]]; then
  project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
fi
project_root="$(cd -- "$project_root" && pwd)"
# HOMEを空にし、npm等が必要とするcacheだけを明示的な一時領域へbindする。
home_dir="${TMPDIR:-/tmp}/secure-home-${UID}"
cache_dir="$home_dir/.cache"
mkdir -p "$home_dir" "$cache_dir"

readonly_dirs=(
  /bin
  /etc
  /lib
  /lib64
  /opt
  /sbin
  /usr
)

args=(
  # 親と同一セッションのままにせず、プロセス・IPC・hostnameを分離する。
  --die-with-parent
  --new-session
  --unshare-user
  --unshare-pid
  --unshare-ipc
  --unshare-uts
  --clearenv
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --tmpfs /run
)

for path in "${readonly_dirs[@]}"; do
  if [[ -e "$path" ]]; then
    args+=(--ro-bind "$path" "$path")
  fi
done

args+=(
  --tmpfs /home/node
  --dir /home/node/.cache
  --bind "$cache_dir" /home/node/.cache
  --bind "$project_root" "$project_root"
  --chdir "$project_root"
  --setenv HOME /home/node
  --setenv USER node
  --setenv LOGNAME node
  --setenv SECURE_PROJECT_ROOT "$project_root"
  --setenv PATH /usr/local/share/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  --setenv SHELL /bin/bash
  --setenv LANG C.UTF-8
  # 通常の外向き通信はallowlist付きegress proxyへ向ける。
  --setenv HTTP_PROXY http://egress-proxy:3128
  --setenv HTTPS_PROXY http://egress-proxy:3128
  --setenv ALL_PROXY http://egress-proxy:3128
  --setenv NO_PROXY localhost,127.0.0.1
)

for path in .devcontainer .github .git .vscode scripts; do
  # Agentがガードレール、CI、信頼script、Git履歴を同じセッション内で変更しないよう再bindする。
  source_path="$project_root/$path"
  if [[ -e "$source_path" ]]; then
    args+=(--ro-bind "$source_path" "$source_path")
  fi
done

exec bwrap "${network_args[@]}" "${args[@]}" -- "$@"
